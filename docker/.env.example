# Connaissance Syncthing + Git-Watcher Configuration
# Copy this to .env and fill in your values

# GitHub authentication
GITHUB_PAT=ghp_xxxxxxxxxxxx
GITHUB_USER=jjurach
GITHUB_REPO=connaissance
GITHUB_EMAIL=phaedrus@example.com

# Vault paths (usually relative to /opt/connaissance/)
VAULT_PATH=/vault

# Git watcher settings
GIT_QUIET_PERIOD=10  # seconds to wait for silence before committing
GIT_AUTHOR_NAME=connaissance-watcher
GIT_AUTHOR_EMAIL=phaedrus@example.com
